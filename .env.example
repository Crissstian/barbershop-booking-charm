# URL e chiave pubblicabile del progetto Supabase ESTERNO.
# Queste VITE_* vengono incluse nel browser: MAI inserire segreti qui.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Disponibili solo sul server (Vercel Functions / sviluppo locale).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ONLY_IN_SECRET_ENVIRONMENT

# Facoltativa, solo per operazioni SQL su un DB che controlli.
# Non eseguire Drizzle push: drizzle/schema.ts non rappresenta lo schema completo.
# DATABASE_URL=postgresql://...

# WHATSAPP_TOKEN e WHATSAPP_PHONE_NUMBER_ID NON sono attivi nella release attuale.
# Non impostarli fino all'implementazione con template Meta approvati.
